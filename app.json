{
  "expo": {
    "name": "Car Check",
    "slug": "car-check",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F7FA",
    "newArchEnabled": true,
    "scheme": "car-check",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B2A4A"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B2A4A",
        "package": "com.ismaelbob.carcheck"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.ismaelbob.carcheck"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "480d0ec1-2de6-43e9-998c-e0b28ae68dac"
      }
    }
  }
}
